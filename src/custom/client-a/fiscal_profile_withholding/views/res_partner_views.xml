<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_form_inherit_fiscal_profile" model="ir.ui.view">
            <field name="name">view.res.partner.form.inherit.fiscal.profile</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account.view_partner_property_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='fiscal_information']" position="inside">
                    <field name="fiscal_profile"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
