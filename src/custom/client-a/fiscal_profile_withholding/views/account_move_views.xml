<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit_withholding" model="ir.ui.view">
            <field name="name">view.account.move.form.inherit.withholding</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='sale_info_group']" position="inside">
                    <field name="withholding_amount" invisible="move_type != 'out_invoice'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
