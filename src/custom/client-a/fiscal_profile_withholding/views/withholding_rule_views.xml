<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_withholding_rule_form" model="ir.ui.view">
            <field name="name">view.withholding.rule.form</field>
            <field name="model">withholding.rule</field>
            <field name="arch" type="xml">
                <form string="Contabilidad: Reglas de Retención">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="fiscal_profile"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group>
                                <field name="withholding_percentage"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_withholding_rule_list" model="ir.ui.view">
            <field name="name">view.withholding.rule.list</field>
            <field name="model">withholding.rule</field>
            <field name="arch" type="xml">
                <list string="Contabilidad: Reglas de Retención">
                    <field name="name" width="200"/>
                    <field name="fiscal_profile" width="200"/>
                    <field name="withholding_percentage" width="200"/>
                    <field name="active" invisible="1"/>
                </list>
            </field>
        </record>

        <record id="withholding_rule_action" model="ir.actions.act_window">
            <field name="name">Contabilidad: Reglas de Retención</field>
            <field name="res_model">withholding.rule</field>
            <field name="view_id" ref="view_withholding_rule_list"/>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
