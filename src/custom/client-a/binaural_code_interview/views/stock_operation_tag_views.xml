<odoo>
    <data>
        <record id="view_stock_operation_tag_form" model="ir.ui.view">
            <field name="name">view.stock.operation.tag.form</field>
            <field name="model">stock.operation.tag</field>
            <field name="arch" type="xml">
                <form string="Inventario: Etiquetas Operativas">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="color" widget="color_picker"/>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="operation_type"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_stock_operation_tag_list" model="ir.ui.view">
            <field name="name">view.stock.operation.tag.list</field>
            <field name="model">stock.operation.tag</field>
            <field name="arch" type="xml">
                <list string="Inventario: Etiquetas Operativas">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="operation_type"/>
                    <field name="color" widget="color_picker"/>
                </list>
            </field>
        </record>

        <record id="stock_operation_tag_action" model="ir.actions.act_window">
            <field name="name">Etiquetas Operativas</field>
            <field name="res_model">stock.operation.tag</field>
            <field name="view_id" ref="view_stock_operation_tag_list"/>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>