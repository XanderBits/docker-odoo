<odoo>
  <data>
    <record id="view_product_template_operation_tag_kanban" model="ir.ui.view">
      <field name="name">view.product_template.operation_tag.kanban</field>
      <field name="model">product.template</field>
      <field name="arch" type="xml">
        <kanban default_group_by="stock_operation_ids">
          <templates>
            <t t-name="card" class="row g-0">
              <main class="col-10 pe-2">
                <field name="name" class="h2"/>
                <span>
                    Precio de venta: <field name="list_price"></field>
                </span>
                <span>
                    Costo: <field name="standard_price"></field>
                </span>
                <field name="stock_operation_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
              </main>
              <aside class="col-2">
                <field name="image_128" widget="image" options="{'img_class': 'o_image_64_contain mw-100'}" alt="Product"/>
              </aside>
            </t>
          </templates>
        </kanban>
      </field>
    </record>
    
    <record id="view_product_template_operation_tag_list" model="ir.ui.view">
      <field name="name">view.product_template.operation_tag.list</field>
      <field name="model">product.template</field>
      <field name="arch" type="xml">
        <list multi_edit="1" editable="bottom">
            <field name="name" readonly="1"/>
            <field name="stock_operation_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
            <field name="default_code" readonly="1"/>
            <field name="list_price" readonly="1"/>
            <field name="standard_price" readonly="1"/>
        </list>
      </field>
    </record>

    <record id="view_template_property_inherit_form" model="ir.ui.view">
      <field name="model">product.template</field>
      <field name="inherit_id" ref="stock.view_template_property_form"/>
      <field name="arch" type="xml">
        <xpath expr="//group[@name='stock_property']" position="after">   <!-- después de Ubicaciones contrapartes -->
          <group string="Etiquetas Operativas" name="stock_operation_tag_group">
            <field name="stock_operation_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
          </group>
        </xpath>
      </field>
    </record>

    <record model="ir.actions.act_window" id="act_window_product_template_operation_tags">
        <field name="name">Productos por etiquetas operativas</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Clasifica tus productos con etiquetas operativas 
                para optimizar tu inventario.
            </p>
        </field>
    </record>

    <record id="action_product_template_operation_tag_view_kanban" model="ir.actions.act_window.view">
      <field name="sequence" eval="1"/>
      <field name="view_mode">kanban</field>
      <field name="view_id" ref="view_product_template_operation_tag_kanban"/>
      <field name="act_window_id" ref="act_window_product_template_operation_tags"/>
    </record>

    <record id="action_product_template_operation_tag_view_list" model="ir.actions.act_window.view">
      <field name="sequence" eval="2"/>
      <field name="view_mode">list</field>
      <field name="view_id" ref="view_product_template_operation_tag_list"/>
      <field name="act_window_id" ref="act_window_product_template_operation_tags"/>
    </record>

  </data>
</odoo>
