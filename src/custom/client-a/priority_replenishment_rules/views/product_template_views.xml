<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_template_property_inherit_form" model="ir.ui.view">
            <field name="model">product.template</field>
            <field name="inherit_id" ref="stock.view_template_property_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='stock_property']" position="after">   <!-- después de Ubicaciones contrapartes -->
                <group string="Prioridades de reabastecimiento" name="priority_replenishment_group">
                    <field name="replenishment_priority"/>
                    <field name="target_stock"/>
                    <field name="needs_replenishment" invisible="1"/>
                </group>
                </xpath>
            </field>
        </record>

        <record id="view_product_template_priority_replenishment_list" model="ir.ui.view">
            <field name="name">view.product.template.priority.replenishment.list</field>
            <field name="model">product.template</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="qty_available" width="200"/>
                    <field name="target_stock" width="200"/>
                    <field name="needs_replenishment" width="200"/>
                    <field name="replenishment_priority"/>
                </list>
            </field>
        </record>

        <record id="view_replenishment_priority_search" model="ir.ui.view">
            <field name="name">replenishment_priority.view.search</field>
            <field name="model">product.template</field>
            <field name="arch" type="xml">
                <search>
                    <filter name="pending_replenishment" string="Pendientes"
                            domain="[('needs_replenishment', '=', True)]"/>
                    <filter name="group_by_priority" string="Prioridad"
                            context="{'group_by': 'replenishment_priority'}"/>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_window_product_priority_replenishment">
            <field name="name">Productos pendiente de reabastecimiento</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_replenishment_priority_search"/>
            <field name="context">{'search_default_pending_replenishment': True, 
                                    'search_default_group_by_priority': True}
            </field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Productos pendiente de reabastecimiento.
                </p>
            </field>
        </record>

        <record id="action_product_template_priority_replenishment_list" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_product_template_priority_replenishment_list"/>
            <field name="act_window_id" ref="act_window_product_priority_replenishment"/>
        </record>
    </data>
</odoo>
